# Video Content Capture configuration example.
# Copy to .env and fill in real values. NEVER commit real secrets.

# Transcription backend: assemblyai (default) or mlx (local Apple Silicon).
# VCC_TRANSCRIPTION_BACKEND=mlx

# AssemblyAI credential (required only when the assemblyai backend is selected).
ASSEMBLYAI_API_KEY=

# Report generation provider (Anthropic Claude).
ANTHROPIC_API_KEY=

# Optional overrides. Defaults shown.
# VCC_LANGUAGE=zh-TW
# VCC_OUTPUT_DIR=./outputs
# VCC_CACHE_DIR=./.vcc-cache
# VCC_MAX_RETRIES=5
# VCC_RETRY_BASE_DELAY_SECONDS=1.0
# VCC_MIN_SPEAKERS=
# VCC_MAX_SPEAKERS=
# VCC_DEFAULT_ANTHROPIC_MODEL=claude-opus-4-8
# VCC_ASSEMBLYAI_MODEL=best
# VCC_MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
