# Video Content Capture configuration example.
# Copy to .env and fill in real values. NEVER commit real secrets.

# Transcription backend: assemblyai (default) or mlx (local Apple Silicon).
# VCC_TRANSCRIPTION_BACKEND=mlx

# AssemblyAI credential (required only when the assemblyai backend is selected).
ASSEMBLYAI_API_KEY=

# Report generation provider (Anthropic Claude).
ANTHROPIC_API_KEY=

# Optional overrides. Defaults shown.
# VCC_LANGUAGE=zh-TW
# VCC_OUTPUT_DIR=./outputs
# VCC_CACHE_DIR=./.vcc-cache
# VCC_MAX_RETRIES=5
# VCC_RETRY_BASE_DELAY_SECONDS=1.0
# VCC_MIN_SPEAKERS=
# VCC_MAX_SPEAKERS=
# VCC_DEFAULT_ANTHROPIC_MODEL=claude-opus-4-8
# VCC_ASSEMBLYAI_MODEL=best
# VCC_MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# YouTube workspace (serve only). Reads only --project-dir/.env.
# Process environment overrides .env; explicit non-secret serve options override both.
# Shared backend-only Gemini key; GOOGLE_API_KEY is never a fallback.
# After editing, restart vcc serve. Never enter a key in the browser.
GEMINI_API_KEY=
# Default: gemini-3.5-flash-lite (account access not yet verified).
VCC_GEMINI_TRANSLATION_MODEL=
# Default: gemini-3.8-flash (account access not yet verified).
VCC_GEMINI_QA_MODEL=
# Default: outputs/library/ relative to --project-dir.
VCC_LIBRARY_DIR=
# Optional loopback bind and port; defaults 127.0.0.1 and 8765.
VCC_HOST=
VCC_PORT=
